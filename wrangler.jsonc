{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redeemid-emdash-demo",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  // Keep variables set in the Cloudflare dashboard when a build deploys.
  // Without this, every deploy removes plain-text dashboard variables.
  "keep_vars": true,
  // EmDash's scheduler: scheduled publishing and plugin tasks, such as
  // RedeemID's daily health check. Every minute, as `emdash doctor` advises.
  "triggers": { "crons": ["* * * * *"] },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emdash-site"
    }
  ],
  // Per-visitor limits on Sign in, Buy and cart changes (RedeemID).
  "ratelimits": [
    {
      "name": "REDEEMID_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "emdash-media"
    }
  ]
}