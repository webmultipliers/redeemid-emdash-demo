---
import { getMenu, getSiteSettings, getEmDashEntry } from 'emdash';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import AccountSlot from '../components/AccountSlot.astro';
import '../styles/global.css';
const {title,description,content}=Astro.props;
const settings=await getSiteSettings(); const menu=await getMenu('primary');
const footerResult=await getEmDashEntry('pages','footer'); Astro.cache.set(footerResult.cacheHint); const footer=footerResult.entry;
const siteTitle=settings.title || 'The Harborview Ledger'; const documentTitle=title ? `${title} — ${siteTitle}`:siteTitle;
const ctx=createPublicPageContext({Astro,kind:content?'content':'custom',pageType:'website',title:documentTitle,pageTitle:title||siteTitle,description,content});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{documentTitle}</title><EmDashHead page={ctx}/></head><body><EmDashBodyStart page={ctx}/><a class="skip" href="#main-content">Skip to content</a><header><div class="top wrap"><span>{new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}).format(new Date())}</span><div><AccountSlot/> <a href="/account/">Account</a> <a href="#">Cart</a></div></div><div class="mast wrap"><div class="mast-side">INDEPENDENT LOCAL JOURNALISM<br/>HARBORVIEW, EST. TODAY</div><a href="/" class="logo">{siteTitle}</a><a class="join" href="/join/">Become a member</a></div><nav class="nav" aria-label="Sections"><div class="wrap navinner">{menu?.items?.map(item=><a href={item.url}>{item.label}</a>)}<a href="/briefings/">Briefings</a><a href="/reports/">Reports</a><a href="/search/">Search ⌕</a></div></nav></header><main id="main-content"><slot/></main><footer><div class="wrap foot"><div><a class="footlogo" href="/">{siteTitle}</a><p {...footer?.edit.intro}>{footer?.data.intro}</p></div><div class="footlinks"><a href="/about/">About</a><a href="/join/">Join</a><a href="/support/">Support</a><a href="/corrections/">Corrections</a></div></div><div class="wrap footnote"><span {...footer?.edit.extra}>{footer?.data.extra}</span> <span>© The Harborview Ledger</span></div></footer><EmDashBodyEnd page={ctx}/></body></html>