---
import SiteLayout from '../layouts/SiteLayout.astro';
import RichText from '../components/ui/RichText.astro';
import {getEmDashCollection,getEmDashEntry} from 'emdash';
import MemberCard from '@redeemid/emdash/components/MemberCard.astro';
import Preferences from '@redeemid/emdash/components/Preferences.astro';
import YourData from '@redeemid/emdash/components/YourData.astro';
import {viewer} from '@redeemid/emdash/access';
import {hasFeature} from '@redeemid/emdash/features';
const {page}=Astro.params; if(!page||!['about','join','support','shop','search','account','briefings','reports','guides','corrections','tag-gates','members-area'].includes(page))return Astro.redirect('/404'); const title=page==='guides'?'City guides':page.charAt(0).toUpperCase()+page.slice(1);
const collectionMap={briefings:'briefings',reports:'reports',guides:'guides',corrections:'corrections'} as const;
const collection=collectionMap[page as keyof typeof collectionMap]; const result=collection ? await getEmDashCollection(collection,{limit:100}) : null; if(result) Astro.cache.set(result.cacheHint);
const copyResult=['about','join','support','shop','tag-gates','members-area'].includes(page) ? await getEmDashEntry('pages',page) : null; if(copyResult) Astro.cache.set(copyResult.cacheHint); const copy=copyResult?.entry;
const member=page==='join' ? (await viewer(Astro)).levels.length>0 : false;
const supporter=page==='support' ? await hasFeature(Astro,'supporter') : false;
---
<SiteLayout title={title}>{result ? <div class="wrap archive"><div class="eyebrow">THE HARBORVIEW LEDGER</div><h1>{title}</h1>{page==='reports' && <nav aria-label="Report series"><a href="/series/harbor-money/">Harbor Money</a> · <a href="/series/port-budgets/">Port budgets</a> · <a href="/series/pensions/">Pensions</a></nav>}<div class="archive-list">{result.entries.map(e=><article><h3><a href={'/'+page+'/'+e.id+'/'}>{e.data.title}</a></h3><p>{e.data.dek}</p></article>)}</div></div> : <div class="article simple">{copy && <><h1 {...copy.edit.title}>{copy.data.title}</h1>{member && <p class="join-thanks" role="status">Thanks for being a member. Your plan is marked below; <a href="/account/">see your membership</a>.</p>}{supporter && <p class="join-thanks" role="status">You're a Ledger supporter. Thank you. Give again any time.</p>}{copy.data.content && <div {...copy.edit.content}><RichText value={copy.data.content} collection="pages"/></div>}{page==='about' && <a class="text-link" href="/corrections/">Read corrections →</a>}</>}{page==='account' && <><MemberCard title="Your Ledger membership"/><Preferences title="Your Ledger preferences"/><YourData/></>}{page==='search' && <><h1>Search the Ledger</h1><form action="/search/" method="get"><label for="q">Search stories and more</label><input id="q" name="q" type="search" value={Astro.url.searchParams.get('q') || ''} style="border:1px solid #5c6670;padding:10px;margin:10px"/><button type="submit">Search →</button></form><p>Search is not yet available across all collections.</p></>}</div>}</SiteLayout>