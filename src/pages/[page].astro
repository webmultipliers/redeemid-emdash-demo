---
import AccountSlot from '../components/AccountSlot.astro';
import Plan from '@redeemid/emdash/components/Plan.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import RichText from '../components/ui/RichText.astro';
import {getEmDashCollection,getEmDashEntry} from 'emdash';
const {page}=Astro.params; if(!page||!['about','join','support','account','search','briefings','reports','guides','corrections'].includes(page))return Astro.redirect('/404'); const title=page==='guides'?'City guides':page.charAt(0).toUpperCase()+page.slice(1);
const collectionMap={briefings:'briefings',reports:'reports',guides:'guides',corrections:'corrections'} as const;
const collection=collectionMap[page as keyof typeof collectionMap]; const result=collection ? await getEmDashCollection(collection,{limit:100}) : null; if(result) Astro.cache.set(result.cacheHint);
const copyResult=['about','join','support'].includes(page) ? await getEmDashEntry('pages',page) : null; if(copyResult) Astro.cache.set(copyResult.cacheHint); const copy=copyResult?.entry;
const tiers=[['free','Free'],['members','Signed in'],['silver','Silver'],['gold','Gold'],['premium','Gold + Silver']] as const;
---
<SiteLayout title={title}>{result ? <div class="wrap archive"><div class="eyebrow">THE HARBORVIEW LEDGER</div><h1>{title}</h1>{page==='reports' && <nav aria-label="Report series"><a href="/series/harbor-money/">Harbor Money</a> · <a href="/series/port-budgets/">Port budgets</a> · <a href="/series/pensions/">Pensions</a></nav>}<div class="archive-list">{result.entries.map(e=><article><h3><a href={'/'+page+'/'+e.id+'/'}>{e.data.title}</a></h3><p>{e.data.dek}</p></article>)}</div></div> : <div class="article simple"><div class="eyebrow">{title}</div>{copy && <><h1 {...copy.edit.heading}>{copy.data.heading}</h1><p {...copy.edit.intro}>{copy.data.intro}</p>{copy.data.body && <div {...copy.edit.body}><RichText value={copy.data.body}/></div>}{page==='about' && <a class="text-link" href="/corrections/">Read corrections →</a>}{page==='join' && <><h2>What each level opens</h2><div>{tiers.map(([key,label])=><p><strong>{label}:</strong> <span {...copy.edit[key]}>{copy.data[key]}</span></p>)}</div><div class="plans"><div class="plan" data-plan="gold"><Plan handle="gold-membership" title="Gold" label="Become a member"><h2>Gold</h2><p {...copy.edit.gold_plan}>{copy.data.gold_plan}</p></Plan></div><div class="plan" data-plan="silver"><Plan handle="silver-membership" title="Silver" label="Become a member"><h2>Silver</h2><p {...copy.edit.silver_plan}>{copy.data.silver_plan}</p></Plan></div></div></>}</>}{page==='account' && <><h1>Your account</h1><div class="plan"><AccountSlot/></div></>}{page==='search' && <><h1>Search the Ledger</h1><form action="/search/" method="get"><label for="q">Search stories and more</label><input id="q" name="q" type="search" value={Astro.url.searchParams.get('q') || ''} style="border:1px solid #5c6670;padding:10px;margin:10px"/><button type="submit">Search →</button></form><p>Search is not yet available across all collections.</p></>}</div>}</SiteLayout>