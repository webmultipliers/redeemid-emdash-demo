---
import {getEmDashCollection,getEmDashEntry} from 'emdash';
import SiteLayout from '../layouts/SiteLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import RichText from '../components/ui/RichText.astro';
const {entries:posts,cacheHint}=await getEmDashCollection('posts',{limit:30}); Astro.cache.set(cacheHint);
const {entries:reports}=await getEmDashCollection('reports'); const {entries:briefings}=await getEmDashCollection('briefings'); const {entries:guides}=await getEmDashCollection('guides'); const {entries:corrections}=await getEmDashCollection('corrections');
const lead=posts.find(p=>p.data.title.startsWith('Harbor pilots')) || posts[0]; const rest=posts.filter(p=>p.id!==lead?.id);
const sections=['Investigations','City Hall','Business','Technology','Science','Culture','Opinion'];
const homeResult=await getEmDashEntry('pages','home'); Astro.cache.set(homeResult.cacheHint); const home=homeResult.entry;
---
<SiteLayout><div class="wrap home"><div class="edition"><span>THE HARBORVIEW LEDGER</span><span>LOCAL STORIES. DEEPER CONTEXT.</span><span>INDEPENDENT BY NATURE</span></div><div class="hero-grid">{lead && <article class="lead"><div class="cover"><div class="cover-lines"></div><span>THE<br/>HARBOR<br/>LEDGER</span><small>REPORTING FROM THE WATERFRONT & BEYOND</small></div><div class="card-section">Investigations · The lead story</div><h1><a href={'/stories/'+lead.id+'/'}>{lead.data.title}</a></h1><p class="lead-dek">{lead.data.dek}</p><div class="byline">{lead.data.author_name} <span class="badge">Gold</span></div></article>}<div class="side-stories">{rest.slice(0,4).map(p=><StoryCard entry={p} compact/>)}</div></div><section class="section"><div class="section-head"><h2>Latest</h2><span>THE STORIES SHAPING OUR CITY</span></div><div class="story-grid">{rest.slice(4,8).map(p=><StoryCard entry={p}/>)}</div></section><section class="membership"><div><span class="eyebrow">A CLOSER CONNECTION</span>{home?.data.content && <div {...home.edit.content}><RichText value={home.data.content}/></div>}<a class="text-link" href="/join/">How membership works →</a></div></section></div><section class="reports-band"><div class="wrap"><div class="section-head"><div><span class="eyebrow">GO DEEPER</span><h2>Ledger Reports</h2></div><a href="/reports/">All reports →</a></div><div class="story-grid scroll">{reports.map(r=><article><span class="eyebrow">SPECIAL REPORT</span><h3><a href={'/reports/'+r.id+'/'}>{r.data.title}</a></h3><p>{r.data.dek}</p></article>)}</div></div></section><div class="wrap">{sections.map(section=>{const found=posts.filter(p=>p.data.terms?.category?.some(t=>t.name===section || t.slug===section.toLowerCase().replace(' ','-'))); return <section class="section"><div class="section-head"><h2>{section}</h2><a href={'/category/'+section.toLowerCase().replace(' ','-')+'/'}>View section →</a></div><div class="story-grid scroll">{found.slice(0,4).map(p=><StoryCard entry={p}/>)}</div></section>})}{([['Briefings','briefings',briefings],['City guides','guides',guides],['Corrections','corrections',corrections]] as [string,string,any[]][]).map(([name,path,items])=><section class="section"><div class="section-head"><h2>{name}</h2><a href={'/'+path+'/'}>View all →</a></div><div class="story-grid scroll">{items.map((item: any)=><article><span class="eyebrow">THE LEDGER</span><h3><a href={'/'+path+'/'+item.id+'/'}>{item.data.title}</a></h3><p>{item.data.dek}</p></article>)}</div></section>)}</div></SiteLayout>