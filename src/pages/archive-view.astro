---
import {getEmDashCollection} from 'emdash'; import SiteLayout from '../layouts/SiteLayout.astro'; import StoryCard from '../components/StoryCard.astro';
const kind=Astro.url.searchParams.get('kind')||'category'; const slug=Astro.url.searchParams.get('slug')||''; const {entries,cacheHint}=await getEmDashCollection(kind==='series'?'reports':'posts',{limit:100}); Astro.cache.set(cacheHint); const matches=entries.filter(e=>e.data.terms?.[kind]?.some(t=>t.slug===slug || (kind==='series' && slug==='harbor-money' && ['port-budgets','pensions'].includes(t.slug)))); const title=slug.replaceAll('-',' ').replace(/\b\w/g,c=>c.toUpperCase());
---
<SiteLayout title={title}><div class="wrap archive"><div class="eyebrow">{kind}</div><h1>{title}</h1>{kind==='series' && <nav aria-label="Report series"><a href="/series/harbor-money/">Harbor Money</a> → <a href="/series/port-budgets/">Port budgets</a> · <a href="/series/pensions/">Pensions</a></nav>}<div class="archive-list">{matches.length?matches.map(e=>kind==='series'?<article><h3><a href={'/reports/'+e.id+'/'}>{e.data.title}</a></h3><p>{e.data.dek}</p></article>:<StoryCard entry={e}/>):<p>No stories in this archive yet.</p>}</div></div></SiteLayout>